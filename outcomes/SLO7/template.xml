<?xml version='1.0' encoding='UTF-8'?>
<knowl mode="exercise" xmlns="https://spatext.clontz.org" version="0.2">
    <knowl>
        <intro>
            <p>
    Consider the following matrix transformations <m>T:\mathbb R^2\rightarrow\mathbb R^2</m> and <m>S:\mathbb R^2\rightarrow\mathbb R^2</m>
          <me>
    T\left( {{e1}} \right)={{Tmap1}}  T\left( {{e2}} \right)={{Tmap2}},  S\left( {{e1}} \right)={{Smap1}}  S\left( {{e2}} \right)={{Smap2}} 
          </me>  
            </p>
        </intro>
        </knowl>
        
        <knowl>
            <content>
                <p>
                    Find the Matrix <m> B </m> and <m> C </m>that defines <m>T</m> and <m>S</m> respectivley.
                </p>
            </content>
            <outtro>
                <p>
                    <m>
       B={{B}} , C={{C}}
                    </m>
                </p>
            </outtro>
    </knowl>

     <knowl>
            <content>
                <p>
                    If <m>v={{v}}</m>, find <m>T(v)</m> and <m>S(v)</m>
                </p>
            </content>
            <outtro>
                <p>
                    <m>
       T(v)={{Tv}} , S(v)={{Sv}}
                    </m>
                </p>
            </outtro>
    </knowl>

     <knowl>
            <content>
                <p>
                    determine the composition <m>({{composition}})(\mathbf w)</m> where <m>\mathbf w = {{w}}</m>
                </p>
            </content>
            <outtro>
                <p>
                    <m>
       ({{composition}})(\mathbf w)={{comp}}
                    </m>
                </p>
            </outtro>
    </knowl>
</knowl>